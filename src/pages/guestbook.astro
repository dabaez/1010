---
import GuestbookForm from '../components/GuestbookForm.astro';
import Shrine from '../layouts/Shrine.astro';
---

<Shrine title="Libro de visitas" description="Los mensajes sellados del último Día del Rito Anual.">
  <section class="center">
    <p class="eyebrow" id="gb-year">&nbsp;</p>
    <h1>Libro de visitas</h1>
    <p class="dim lede" id="gb-intro">&nbsp;</p>
  </section>

  <section class="panel" id="gb-write" hidden>
    <GuestbookForm />
  </section>

  <section class="panel">
    <div id="gb-entries"><p class="dim">Cargando…</p></div>
  </section>

  <p class="center"><a href="/archive/">Libros de años anteriores →</a></p>
</Shrine>

<style>
  .lede {
    max-width: 34rem;
    margin: 0 auto 2.5rem;
  }
</style>

<script>
  import { $, el, fetchState, fmt, getJson, utc } from '../scripts/api';
  import { createGuestbookForm } from '../scripts/gb-form';
  import { renderEntries, type Entry } from '../scripts/year-view';

  const form = createGuestbookForm(render);
  await render();

  async function render(): Promise<void> {
    const state = await fetchState();
    const { year, entries } = await getJson<{ year: number | null; entries: Entry[] }>('/api/guestbook');
    const intro = $('#gb-intro');
    $('#gb-year').textContent = `El Día de ${year ?? state.window.year}`;

    if (state.phase === 'open') {
      intro.replaceChildren('Abierto hasta el ', utc(state.window.closesAt), '.', el('br'), 'Deja tu mensaje aquí abajo.');
    } else if (year === null) {
      intro.textContent = `Se abre el ${utc(state.window.opensAt)}.`;
    } else {
      intro.textContent = `${fmt(entries.length)} ${entries.length === 1 ? 'mensaje sellado' : 'mensajes sellados'}. Vuelve a abrirse el ${utc(state.window.opensAt)}.`;
    }
    $('#gb-write').hidden = state.phase !== 'open';
    form.render(state);
    $('#gb-entries').replaceChildren(year === null ? el('p', { class: 'dim' }, 'Aún no hay mensajes.') : renderEntries(entries));
  }
</script>
