---
// The final page. The server serves it at / once all twelve rings stand on C,
// and forever after. Try it with FAKE_STATE=CCCCCCCCCCCC.
import Shrine from '../layouts/Shrine.astro';
import { LEDGER_REPO_URL } from '../shared/site';
---

<Shrine title="La programación ha terminado" description="Los doce anillos están en C. El Rito Anual está completo." bare>
  <section class="end center">
    <p class="eyebrow">1010</p>
    <svg id="tower-svg" class="tower-svg"></svg>
    <h1>La programación ha terminado.</h1>
    <p class="lede" id="lede">Los doce anillos están en C.</p>

    <dl class="tally" id="tally" hidden>
      <div><dt>Días</dt><dd id="days">–</dd></div>
      <div><dt>Movimientos</dt><dd id="moves">–</dd></div>
      <div><dt>Juego perfecto</dt><dd>4.095</dd></div>
      <div><dt>Rodeos</dt><dd id="extra">–</dd></div>
    </dl>

    <div class="words">
      <p>
        Empezó el nueve de octubre de 2026, con todos los anillos en A y una profecía precisa: no B, sino C. Una vez al
        año, durante cincuenta horas, era 10 de octubre en algún lugar de la Tierra; quien llegaba votaba, y un anillo se
        movía.
      </p>
      <p>
        A la multitud nunca se le dijo qué movimiento era sabio. Tropezó, retrocedió y siguió viniendo. Esto es lo que
        construyó, un año a la vez.
      </p>
      <p>
        El templo no volverá a abrir. Su registro permanece: cada Número y cada Bit, cada conteo, y el libro de visitas
        sellado, cuyos sellos siguen cayendo a su propio ritmo, un cuadrado tras otro, mucho después del último voto.
      </p>
    </div>

    <p class="links">
      <a href="/tower/">Todo el viaje</a> · <a href="/archive/">El archivo</a> · <a href="/solver/">Abrir un sello</a> ·{' '}
      <a href={LEDGER_REPO_URL}>El registro</a>
    </p>
  </section>
</Shrine>

<style>
  .end {
    padding: 4rem 0 5rem;
  }
  .tower-svg {
    width: 100%;
    max-width: 34rem;
    height: auto;
    display: block;
    margin: 2rem auto 2.5rem;
    filter: drop-shadow(0 0 40px rgba(220, 174, 85, 0.22));
    animation: rise 3.5s ease-out both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    color: var(--gold-2);
    text-shadow: 0 0 40px rgba(220, 174, 85, 0.3);
  }
  .lede {
    font-size: 1.45rem;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 2.5rem;
  }
  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1rem;
    max-width: 34rem;
    margin: 0 auto 3rem;
  }
  .tally div {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.8rem 0.4rem;
  }
  .tally dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .tally dd {
    margin: 0.2rem 0 0;
    font-family: var(--mono);
    font-size: 1.3rem;
    color: var(--gold-2);
  }
  .words {
    text-align: left;
    max-width: 34rem;
    margin: 0 auto 2.5rem;
    color: var(--ink);
  }
  .links {
    font-style: italic;
  }
</style>

<script>
  import { $, fmt, getJson } from '../scripts/api';
  import { drawTower } from '../scripts/tower-draw';
  import { GOAL_STATE, OPTIMAL_TOTAL } from '../shared/tower';

  const svg = document.querySelector<SVGSVGElement>('#tower-svg')!;
  drawTower(svg, GOAL_STATE, { label: 'Los doce anillos en el poste C' });

  try {
    const t = await getJson<{ movesMade: number; history: { year: number }[] }>('/api/tower');
    const last = t.history.at(-1);
    if (last && t.movesMade >= OPTIMAL_TOTAL) {
      $('#lede').textContent = `El Día de ${last.year}, después de ${fmt(t.movesMade)} movimientos, el duodécimo anillo llegó a descansar en C.`;
      $('#days').textContent = fmt(t.history.length);
      $('#moves').textContent = fmt(t.movesMade);
      $('#extra').textContent = fmt(t.movesMade - OPTIMAL_TOTAL);
      $('#tally').hidden = false;
    }
  } catch {
    /* the words stand on their own */
  }
</script>
