---
// The final page. The server serves it at / once all twelve rings stand on C,
// and forever after. Try it with FAKE_STATE=CCCCCCCCCCCC.
import Shrine from '../layouts/Shrine.astro';
import { LEDGER_REPO_URL } from '../shared/site';
---

<Shrine title="Programming is over" description="All twelve rings stand on C. The Annual Rite is complete." bare>
  <section class="end center">
    <p class="eyebrow">1010</p>
    <svg id="tower-svg" class="tower-svg"></svg>
    <h1>Programming is over.</h1>
    <p class="lede" id="lede">All twelve rings stand on C.</p>

    <dl class="tally" id="tally" hidden>
      <div><dt>Days</dt><dd id="days">–</dd></div>
      <div><dt>Moves</dt><dd id="moves">–</dd></div>
      <div><dt>Perfect play</dt><dd>4,095</dd></div>
      <div><dt>Wandering</dt><dd id="extra">–</dd></div>
    </dl>

    <div class="words">
      <p>
        It began on the ninth of October 2026, with every ring on A and a prophecy that was specific: not B, but C.
        Once a year, for fifty hours, it was October 10 somewhere on Earth, and whoever came voted, and one ring moved.
      </p>
      <p>
        The crowd was never told which move was wise. It stumbled, doubled back, and kept coming. This is what it
        built, one year at a time.
      </p>
      <p>
        The shrine will not open again. Its record remains: every Number and every Bit, every tally, and the sealed
        guestbook, whose seals keep falling on their own schedule, one squaring after another, long after the last
        vote.
      </p>
    </div>

    <p class="links">
      <a href="/tower/">The whole journey</a> · <a href="/archive/">The archive</a> · <a href="/solver/">Open a seal</a> ·{' '}
      <a href={LEDGER_REPO_URL}>The ledger</a>
    </p>
  </section>
</Shrine>

<style>
  .end {
    padding: 4rem 0 5rem;
  }
  .tower-svg {
    width: 100%;
    max-width: 34rem;
    height: auto;
    display: block;
    margin: 2rem auto 2.5rem;
    filter: drop-shadow(0 0 40px rgba(220, 174, 85, 0.22));
    animation: rise 3.5s ease-out both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    color: var(--gold-2);
    text-shadow: 0 0 40px rgba(220, 174, 85, 0.3);
  }
  .lede {
    font-size: 1.45rem;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 2.5rem;
  }
  .tally {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 1rem;
    max-width: 34rem;
    margin: 0 auto 3rem;
  }
  .tally div {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.8rem 0.4rem;
  }
  .tally dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .tally dd {
    margin: 0.2rem 0 0;
    font-family: var(--mono);
    font-size: 1.3rem;
    color: var(--gold-2);
  }
  .words {
    text-align: left;
    max-width: 34rem;
    margin: 0 auto 2.5rem;
    color: var(--ink);
  }
  .links {
    font-style: italic;
  }
</style>

<script>
  import { $, fmt, getJson } from '../scripts/api';
  import { drawTower } from '../scripts/tower-draw';
  import { GOAL_STATE, OPTIMAL_TOTAL } from '../shared/tower';

  const svg = document.querySelector<SVGSVGElement>('#tower-svg')!;
  drawTower(svg, GOAL_STATE, { label: 'All twelve rings on peg C' });

  try {
    const t = await getJson<{ movesMade: number; history: { year: number }[] }>('/api/tower');
    const last = t.history.at(-1);
    if (last && t.movesMade >= OPTIMAL_TOTAL) {
      $('#lede').textContent = `On the Day of ${last.year}, after ${fmt(t.movesMade)} moves, the twelfth ring came to rest on C.`;
      $('#days').textContent = fmt(t.history.length);
      $('#moves').textContent = fmt(t.movesMade);
      $('#extra').textContent = fmt(t.movesMade - OPTIMAL_TOTAL);
      $('#tally').hidden = false;
    }
  } catch {
    /* the words stand on their own */
  }
</script>
