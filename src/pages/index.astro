---
import Ballot from '../components/Ballot.astro';
import GuestbookForm from '../components/GuestbookForm.astro';
import Shrine from '../layouts/Shrine.astro';
---

<Shrine>
  <noscript>
    <p class="note">El templo necesita JavaScript para sincronizarse con el servidor y sellar mensajes en tu navegador.</p>
  </noscript>

  <!-- The hero changes with the phase: a countdown while sealed, the opening ceremony on the Day. -->
  <section id="hero" class="hero center" data-phase="loading" aria-live="polite">
    <p class="eyebrow" id="hero-eyebrow">&nbsp;</p>
    <h1 id="hero-title">El templo</h1>

    <div id="ceremony" class="ceremony" hidden>
      <p class="eyebrow">El Número de <span data-year></span></p>
      <p class="number mono" id="number-dec" aria-label="El Número del año">&nbsp;</p>
      <p class="number-hex mono" id="number-hex">&nbsp;</p>
      <div class="bit-row">
        <span class="eyebrow">El Bit</span>
        <span class="bit mono" id="bit">·</span>
      </div>
      <p class="dim small" id="ceremony-source">&nbsp;</p>
    </div>

    <div class="countdown mono" id="countdown" role="timer" aria-live="off">
      <div><span data-u="d">--</span><small>días</small></div>
      <div><span data-u="h">--</span><small>horas</small></div>
      <div><span data-u="m">--</span><small>minutos</small></div>
      <div><span data-u="s">--</span><small>segundos</small></div>
    </div>
    <p id="hero-sub" class="dim">&nbsp;</p>
  </section>

  <section class="panel" id="tower-panel" aria-labelledby="tower-h">
    <h2 id="tower-h"><span class="numeral">I</span>La Torre</h2>
    <p><a href="/tower/">Historia de movimientos →</a></p>
    <p class="dim">Doce anillos que deben pasar de A a C. Cada Día se mueve uno, por votación.</p>
    <svg id="tower-svg" class="tower-svg"></svg>
    <p class="stat-row">
      <span>Movimientos hechos: <strong id="moves-made">–</strong>.</span>
      <span>Movimientos óptimos restantes: <strong id="optimal-remaining">–</strong>.</span>
    </p>
    <Ballot />
  </section>

  <section class="panel" id="guestbook-panel" aria-labelledby="gb-h">
    <h2 id="gb-h"><span class="numeral">II</span>El Libro de Visitas Sellado</h2>
    <p><a href="/guestbook/">Mensajes sellados →</a></p>
    <p class="dim">Cada mensaje se sella en tu navegador. Cualquiera puede abrirlo, pero toma años de cálculo.</p>
    <div id="gb-closed">
      <p><strong id="gb-count">–</strong> <span id="gb-count-label">mensajes sellados</span>. El libro se abre el Día.</p>
    </div>
    <GuestbookForm />
  </section>

  <section class="panel" id="number-panel" aria-labelledby="num-h">
    <h2 id="num-h"><span class="numeral">III</span>El Número y el Bit</h2>
    <p class="dim">Un número y un bit aleatorios por año, de la baliza pública drand.</p>
    <div id="number-details"></div>
    <p><a href="/archive/">Todos los años →</a></p>
  </section>
</Shrine>

<style>
  .hero {
    padding: 1rem 0 3.5rem;
  }
  .hero h1 {
    margin-bottom: 1.6rem;
  }
  .countdown {
    display: flex;
    justify-content: center;
    gap: clamp(0.7rem, 4vw, 2.4rem);
    margin: 0 auto 1.4rem;
  }
  .countdown div {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.2ch;
  }
  .countdown span {
    font-size: clamp(2.4rem, 10vw, 4.4rem);
    line-height: 1;
    color: var(--gold-2);
    font-weight: 400;
    text-shadow: 0 0 28px rgba(220, 174, 85, 0.25);
    font-variant-numeric: tabular-nums;
  }
  .countdown small {
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 0.6rem;
  }
  .hero[data-phase='open'] .countdown span {
    font-size: clamp(1.4rem, 6vw, 2.2rem);
    color: var(--ink);
    text-shadow: none;
  }
  .ceremony {
    margin: 0 auto 2.4rem;
  }
  .number {
    font-size: clamp(1.15rem, 5.6vw, 2.5rem);
    white-space: nowrap;
    color: var(--gold-2);
    letter-spacing: 0.02em;
    margin: 0.4rem 0 0.2rem;
    text-shadow: 0 0 36px rgba(220, 174, 85, 0.35);
    font-variant-numeric: tabular-nums;
  }
  .number.drawing {
    color: var(--dim);
    text-shadow: none;
  }
  .number-hex {
    color: var(--dim);
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }
  .bit-row {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 0.35rem 0.6rem 0.35rem 1.2rem;
    margin-bottom: 1rem;
  }
  .bit {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #4a3a1c, #1a140b);
    border: 1px solid #6d5428;
    color: var(--gold-2);
    font-size: 1.4rem;
  }
  .small {
    font-size: 0.95rem;
  }
  .tower-svg {
    width: 100%;
    height: auto;
    display: block;
    margin: 0.5rem 0 1rem;
  }
  #number-details :global(dl) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.35rem 1.2rem;
    margin: 0 0 1rem;
  }
  #number-details :global(dt) {
    color: var(--dim);
  }
  #number-details :global(dd) {
    margin: 0;
    min-width: 0;
  }
  @media (max-width: 34rem) {
    #number-details :global(dl) {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
    #number-details :global(dd) {
      margin-bottom: 0.6rem;
    }
  }
</style>

<script>
  import { mountHome } from '../scripts/home';
  mountHome();
</script>
