---
import Ballot from '../components/Ballot.astro';
import Shrine from '../layouts/Shrine.astro';
---

<Shrine title="La Torre" description="La Torre de Hanói del Rito Anual: su estado actual y cada movimiento hecho, uno por año." wide>
  <section class="center">
    <p class="eyebrow">Ritual I</p>
    <h1>La Torre</h1>
    <p class="dim lede">
      Un movimiento por año, elegido por votación. Jugando perfecto, toma 4.095 años.
    </p>
  </section>

  <section class="panel">
    <svg id="tower-svg" class="tower-svg"></svg>
    <p class="stat-row center-row">
      <span>Estado: <strong id="state" class="mono">–</strong></span>
      <span>Movimientos hechos: <strong id="moves-made">–</strong>.</span>
      <span>Movimientos óptimos restantes: <strong id="optimal-remaining">–</strong>.</span>
    </p>
    <div class="replay" id="replay" hidden>
      <label for="replay-range" class="eyebrow">Repetición: después de <span id="replay-label">–</span></label>
      <input type="range" id="replay-range" min="0" max="0" value="0" step="1" />
    </div>
    <Ballot />
  </section>

  <section>
    <h2>Todos los movimientos</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Día</th>
            <th>Movimiento</th>
            <th>Votos</th>
            <th>Decidido por</th>
            <th>Óptimos restantes</th>
          </tr>
        </thead>
        <tbody id="history">
          <tr><td colspan="6" class="dim">Cargando…</td></tr>
        </tbody>
      </table>
    </div>
    <p class="dim small">
      El estado indica el poste de cada anillo, del más pequeño al más grande.
    </p>
  </section>
</Shrine>

<style>
  .lede {
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }
  .tower-svg {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1rem;
  }
  .center-row {
    justify-content: center;
  }
  .replay {
    margin-top: 1.5rem;
  }
  .replay input {
    width: 100%;
    accent-color: var(--gold);
  }
  .small {
    font-size: 0.95rem;
  }
</style>

<script>
  import { $, el, fetchState, fmt, getJson } from '../scripts/api';
  import { createBallot } from '../scripts/ballot';
  import { drawTower } from '../scripts/tower-draw';
  import { START_STATE, applyMove, parseMove } from '../shared/tower';

  interface MoveView {
    year: number;
    number: number;
    state_before: string;
    move: string;
    state_after: string;
    tally: Record<string, number>;
    decided_by: 'votes' | 'tiebreak' | 'no_votes';
    optimal_remaining: number;
  }
  interface TowerResponse {
    state: string;
    movesMade: number;
    optimalRemaining: number;
    complete: boolean;
    history: MoveView[];
  }

  const DECIDED = { votes: 'votos', tiebreak: 'empate, roto por la baliza', no_votes: 'sin votos; eligió la baliza' };

  const t = await getJson<TowerResponse>('/api/tower');
  const svg = document.querySelector<SVGSVGElement>('#tower-svg')!;
  drawTower(svg, t.state);

  // On the Day, the ballot is here too. Choosing a move shows it on today's tower.
  const ballot = createBallot({
    refresh: async () => ballot.render(await fetchState()),
    onSelect: (move) => {
      const range = document.querySelector<HTMLInputElement>('#replay-range');
      if (range) {
        range.value = range.max;
        range.dispatchEvent(new Event('input'));
      }
      drawTower(svg, t.state, { preview: move ? applyMove(t.state, parseMove(move)!) : null });
    },
  });
  ballot.render(await fetchState());
  $('#state').textContent = t.state;
  $('#moves-made').textContent = fmt(t.movesMade);
  $('#optimal-remaining').textContent = fmt(t.optimalRemaining);

  const body = $('#history');
  if (!t.history.length) {
    body.replaceChildren(el('tr', {}, el('td', { colspan: '6', class: 'dim' }, 'Aún no se ha hecho ningún movimiento. El primero se hace al cierre del primer Día.')));
  } else {
    body.replaceChildren(
      ...[...t.history].reverse().map((m) =>
        el(
          'tr',
          {},
          el('td', {}, String(m.number)),
          el('td', {}, String(m.year)),
          el('td', { class: 'mono' }, m.move),
          el('td', { class: 'mono' }, Object.entries(m.tally).map(([k, v]) => `${k} ${v}`).join(' · ')),
          el('td', {}, DECIDED[m.decided_by] ?? m.decided_by),
          el('td', { class: 'mono' }, fmt(m.optimal_remaining)),
        ),
      ),
    );

    const replay = $('#replay');
    const range = $('#replay-range') as HTMLInputElement;
    const label = $('#replay-label');
    replay.hidden = false;
    range.max = String(t.history.length);
    range.value = String(t.history.length);
    const show = () => {
      const i = Number(range.value);
      const state = i === 0 ? START_STATE : t.history[i - 1]!.state_after;
      label.textContent = i === 0 ? 'el comienzo' : `el Día de ${t.history[i - 1]!.year} (movimiento ${i})`;
      drawTower(svg, state);
    };
    range.addEventListener('input', show);
    show();
  }
</script>
