---
import Shrine from '../layouts/Shrine.astro';
import { Content } from '../../RULES.md';
---

<Shrine title="Reglas" description="Las reglas del Rito Anual en palabras simples, incluida la cláusula de sucesión.">
  <article class="prose">
    <Content />
  </article>
</Shrine>

<style>
  .prose :global(h1) {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .prose :global(h2) {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    margin: 0 0 1.4rem;
  }
  .prose :global(li) {
    margin-bottom: 0.35rem;
  }
</style>
