---
import Shrine from '../layouts/Shrine.astro';
---

<Shrine title="Archivo" description="Cada año del Rito Anual: el Número y el Bit, la votación y los mensajes sellados.">
  <section class="center">
    <p class="eyebrow">El registro</p>
    <h1>Archivo</h1>
  </section>

  <div id="latest"><p class="dim center">Cargando…</p></div>

  <section id="previous" hidden>
    <h2>Años anteriores</h2>
    <div id="year-list"></div>
  </section>

  <section class="panel next" id="next" hidden></section>
</Shrine>

<style>
  #previous {
    margin: 0 0 2.5rem;
  }
  .next {
    font-size: 1.05rem;
  }
</style>

<script>
  import { drandRoundUrl } from '../shared/beacon';
  import { $, el, fmt, getJson, utc } from '../scripts/api';
  import { renderYear, renderYearList, type YearFull, type YearSummary } from '../scripts/year-view';

  interface ArchiveResponse {
    latest: YearFull | null;
    years: YearSummary[];
    next: { year: number; opensAt: string; numberRound: number };
  }

  const data = await getJson<ArchiveResponse>('/api/archive');

  $('#latest').replaceChildren(
    data.latest ? renderYear(data.latest) : el('p', { class: 'center dim' }, 'Aún no hay nada registrado.'),
  );

  const older = data.years.filter((y) => y.year !== data.latest?.year);
  if (older.length) {
    $('#year-list').replaceChildren(renderYearList(older));
    $('#previous').hidden = false;
  }

  // The round for the next Number is already fixed, so nobody can choose it.
  const n = data.next;
  const next = $('#next');
  next.replaceChildren(
    el('h2', {}, `El Número de ${n.year}`),
    el(
      'p',
      {},
      'Saldrá de la ronda ',
      el('a', { href: drandRoundUrl(n.numberRound) }, fmt(n.numberRound)),
      ` de drand, que se publicará el ${utc(n.opensAt)}. Esa ronda está fijada desde ahora, así que nadie, ni siquiera nosotros, puede elegir el número.`,
    ),
  );
  next.hidden = false;
</script>
