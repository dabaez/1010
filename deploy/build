#!/usr/bin/env bash
#
# build — builds the Annual Rite on the droplet.
#
# receive-site (dabaez/droplet-infra) runs this as the rite user, from the
# uploaded source (the release's app/), on every deploy:
#
#   deploy/build <out-dir>
#
# The site is a server process: the built pages go to <out-dir> (the
# release's public/), and the server bundle plus its production
# node_modules stay in app/, where deploy/systemd/rite.service runs them.
# better-sqlite3 is native, which is why this builds here and not in CI.
#
set -euo pipefail

OUT="$1"

command -v node >/dev/null || {
  echo "node isn't on PATH for $(id -un); install Node 22 system-wide" >&2
  exit 1
}

# pnpm comes from corepack, at the version in package.json's packageManager.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
mkdir -p "$HOME/.local/bin"
corepack enable --install-directory "$HOME/.local/bin" pnpm
export PATH="$HOME/.local/bin:$PATH"

rm -rf node_modules dist build .astro
pnpm install --frozen-lockfile
pnpm build
cp -r dist/. "$OUT"/

# Keep only what the server needs at runtime.
CI=true pnpm prune --prod
pnpm store prune >/dev/null 2>&1 || true
rm -rf dist .astro
test -f build/server/main.mjs
