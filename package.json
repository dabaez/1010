{
  "name": "annual-rite",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:server": "tsx watch src/server/main.ts",
    "build": "astro build && node scripts/build-server.mjs",
    "start": "node build/server/main.mjs",
    "rite": "tsx src/server/cli.ts",
    "demo": "astro build && tsx scripts/demo.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "drand-client": "^1.4.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "astro": "^7.3.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
